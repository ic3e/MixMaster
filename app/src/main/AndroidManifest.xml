<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app lock checks the phone's own fingerprint / face / screen lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Checking for and fetching a new build of this app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The mixing timer buzzes when a batch is done: a site is too loud for sound alone. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The mixing timer has to land even with the app off screen: it books the end of a batch
         with the system clock and comes back as a full-screen alert. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- A restart cancels every alarm the app had booked. A batch that is still due gets booked
         again, so a phone that reboots mid-mix does not lose the mix. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:name=".MixMasterApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MixMaster">

        <!--
            configChanges: the app configures its own locale. Handling that change here, rather
            than being relaunched for it, means a disagreement with the system configuration can
            never turn into a relaunch loop.

            The rest of the list is for the mixing timer. A relaunch throws away a running batch
            — the clock, the tally, the calculator behind it — and turning the phone sideways at
            the mixer is not a reason to lose a mix. Compose lays itself out again from the new
            configuration on its own. Theme, font scale and display size are left off the list
            deliberately: those are worth a clean rebuild, and nobody changes them mid-batch.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MixMaster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".ui.calculator.MixAlarmReceiver"
            android:exported="false" />

        <!-- Exported because these are system broadcasts; both are protected by the system. -->
        <receiver
            android:name=".ui.calculator.MixRestartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
