<?xml version="1.0" encoding="utf-8"?>
<!-- ConWiC badge, traced from the supplied logo artwork. The mark is knocked out of the
     brown block, so the counter shows the block through it. Path data lives in
     res/values/logo_paths.xml, shared with the PDF report. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="66dp"
    android:height="40dp"
    android:viewportWidth="406"
    android:viewportHeight="246">
    <path
        android:fillColor="#704727"
        android:pathData="@string/conwic_badge_block_path" />
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="@string/conwic_badge_mark_path" />
</vector>
